# Repo-wide values, shared by every stack and script. Copy to .env:
#
#   cp .env.example .env && chmod 600 .env
#
# This is the ONE place these names are written down. Per-stack .env files
# hold that stack's own settings; anything here is read by more than one of
# them, and duplicating it into each is how the copies drift apart.
#
# Only non-secret identifiers belong here. `env_file` hands a container EVERY
# key in this file, so a credential put here would be injected into every
# stack that reads it. Secrets go in the stack .env that needs them.
#
# Values are left unfilled rather than given a working example, for the same
# reason as every guarded secret: nothing here has a fallback default, so an
# unset one fails loudly, and a public hostname committed to this repo is
# exactly what keeping them here avoids. See docs/lessons-learned.md §3.

# The public domain whose wildcard certificate Caddy issues, e.g.
# example.com -- NOT a subdomain, and no scheme or trailing dot. Caddy serves
# `*.<this>` from the DNS-01 block in stacks/caddy/config/Caddyfile.
PUBLIC_DOMAIN=

# The dynamic-DNS name that tracks this host's public IP, e.g.
# something.duckdns.org. The headscale control plane and DERP relay live
# here, so every tailnet node depends on it resolving. Set the subdomain and
# token themselves in stacks/duckdns/.env.
DUCKDNS_HOST=

# The same name again, as a URL, for headscale. Compose cannot build one
# variable out of another across files -- `env_file` hands values to a
# container verbatim and never feeds `${VAR}` interpolation -- and the two
# consumers need different forms: Caddy composes `auth.<bare name>`, while
# headscale's server_url must carry a scheme. So it is written twice, on
# purpose, on adjacent lines.
#
# They must agree. scripts/check_derp.py fails if they do not, because a
# server_url pointing somewhere else re-registers every tailnet node against
# a URL that does not work -- and changing it is the one edit in this file
# that can lock you out of the machine you would fix it from.
HEADSCALE_SERVER_URL=https://

# The Jellyfin LXC's LAN address, e.g. 10.0.0.12. Jellyfin runs outside
# Docker, so Caddy reaches it by address ({$JELLYFIN_HOST} in the Caddyfile)
# and scripts/check_updates.py reads its version from it.
JELLYFIN_HOST=

# The tailnet's MagicDNS domain, e.g. tailnet.internal. Headscale reads it as
# dns.base_domain (stacks/headscale/config/config.yaml does not set it). It
# must differ from the server_url domain. Unset, headscale refuses to start.
HEADSCALE_DNS_BASE_DOMAIN=

# The house's public IPv4, e.g. 203.0.113.7. The embedded DERP relay is
# pinned to it in the DERP map (scripts/render_derp_map.py renders it into
# stacks/headscale/config/derp/custom.yaml); scripts/check_derp.py alerts when
# it no longer matches the real public IP.
DERP_IPV4=

# The LAN's CIDR, e.g. 10.0.0.0/24. Caddy's remote_ip gates admit it
# ({$LAN_CIDR} in stacks/caddy/config/Caddyfile) alongside the tailnet.
# Unset, LAN clients are refused by every gated vhost.
LAN_CIDR=
