# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
# Daily at 4am, in TZ above. Six fields -- leading one is seconds.
WATCHTOWER_SCHEDULE=0 0 4 * * *
# Optional shoutrrr URL for notifications, e.g.
#   smtp://user:pass@smtp.example.com:587/?from=x@y&to=x@y
# NEVER inline credentials in compose.yaml -- the legacy definition did.
WATCHTOWER_NOTIFICATION_URL=
