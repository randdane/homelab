# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PUID=1000
PGID=1000
# CRON_SCHEDULE=0 4 * * *

# The site-data checkout, e.g. /opt/homelab-private. The channel list is its
# stacks/ytdl-sub/site/subscriptions.yaml (template: site.example/).
SITE_DIR=

# healthchecks.io check for the nightly run: period 1 day, grace 2 h.
# e.g. https://hc-ping.com/<ping-key>/ytdl-sub. Blank = no alerting.
HC_URL=
