# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago

# --- Secrets. Generate with: openssl rand -hex 32 -------------------------
# Signs Vikunja's JWTs. Unset means a new random secret every boot, which
# logs every session out on every restart.
VIKUNJA_SERVICE_SECRET=

# MUST be set before n8n starts for the FIRST time. n8n encrypts stored
# credentials with this key; changing it later orphans all of them, with no
# recovery path. Migrating an existing n8n volume? Carry the OLD key over.
N8N_ENCRYPTION_KEY=

# --- Addresses ------------------------------------------------------------
# The base for links Vikunja hands out. Must be the address the phone
# actually uses, i.e. the tailnet one — not localhost, not the LAN IP, or
# links will only work from inside the house.
# Required. The base for every link Vikunja hands out -- the reminder deep
# links n8n sends through ntfy included. Set it to the name people
# ACTUALLY open Vikunja by, from the device they open it on.
#
# A tailnet-only address is the wrong answer even though it works from your
# desk: a phone that has dropped off the tailnet still receives the reminder
# and the link then leads nowhere. Prefer a name that resolves in every state
# the client is really in -- see stacks/caddy/README.md for the vhost, and
# `docs/lessons-learned.md` for why this is left blank rather than filled with
# a working example.
VIKUNJA_PUBLIC_URL=
N8N_PUBLIC_URL=http://my-server.local:5679/

# Required, and it must be the bare domain -- e.g. example.com, no scheme,
# no subdomain. The homepage.href label composes `<name>.${PUBLIC_DOMAIN}`
# from it. Compose interpolates labels from THIS file and never from the
# repo-wide .env, so the same value is written in each stack that needs it;
# `env_file` hands values to a container and does not feed `${VAR}`.
# Left blank on purpose -- see docs/lessons-learned.md 3.
PUBLIC_DOMAIN=

# Still used by the n8n reminders tile, which has no vhost of its own.
HOMELAB_HOST=

VIKUNJA_PORT=3456
N8N_PORT=5679


# --- Vikunja API token, used by the reminder workflow's overdue poll ------
# Vikunja -> Settings -> API tokens. Needs task read permission.
VIKUNJA_TOKEN=

# --- SSO through Authentik, provider `vikunja` ------------------------------
# From the Authentik provider. Blank leaves the button broken, not hidden.
VIKUNJA_OIDC_CLIENT_ID=
VIKUNJA_OIDC_CLIENT_SECRET=
