# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8200
PUID=1000
PGID=1000
# Required. Encrypts stored destination credentials -- back this up separately
# from Duplicati itself, or you cannot restore. openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
# Required. Web UI password. openssl rand -base64 24
WEBSERVICE_PASSWORD=
# Required: the vhost is duplicati.<PUBLIC_DOMAIN>. Canonical copy is the
# repo-root .env.
PUBLIC_DOMAIN=
