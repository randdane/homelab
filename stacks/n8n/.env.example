# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=5678
# Required, and must be set BEFORE first run. Encrypts stored credentials;
# changing it later orphans every saved credential. openssl rand -base64 32
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
# The URL third parties will call back on, not the one n8n sees internally.
WEBHOOK_URL=http://localhost:5678/
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
