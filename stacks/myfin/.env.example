# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8086
API_PORT=8085
# Resolved by your BROWSER -- use the server hostname, not localhost,
# if you open MyFin from another device.
API_URL=http://localhost:8085
DB_NAME=myfin
DB_USER=myfin
# Required. openssl rand -base64 32 for each.
MYSQL_ROOT_PASSWORD=
DB_PW=
LOGGING=true
ENABLE_USER_SIGNUP=false
# Optional: leave empty to disable password-reset email.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
