# Copy to .env and fill in. .env is gitignored; this file is not.

# Host port. HEADSCALE_PORT is gone: this stack no longer publishes an HTTP
# port at all. Caddy owns 80/443 and reverse-proxies the control plane, which
# is the "moving headscale behind a reverse proxy" case the old comment here
# treated as hypothetical. STUN is the one thing still published directly --
# it is UDP, and Caddy does not proxy it.
STUN_PORT=3478

# The site-data checkout (homelab-private, or your own copy of site.example/),
# e.g. /opt/homelab-private. Headscale mounts its stacks/headscale/site/.
SITE_DIR=
