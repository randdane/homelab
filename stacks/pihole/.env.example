# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
# Server: 53. Laptop: systemd-resolved already holds 53, so override.
DNS_PORT=53
PORT=8091
# Required. Web UI password. Generate with: openssl rand -base64 24
PIHOLE_PASSWORD=
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
