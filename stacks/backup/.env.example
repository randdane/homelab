# Copy to .env and fill in. .env is gitignored; this file is not.
# Every value here is optional -- the compose file has working defaults.

# Controls when the cron below fires. Wrong TZ means a backup during the day.
TZ=America/Chicago

# Defaults to ${XDG_STATE_HOME:-$HOME/.local/state}/homelab/backups.
# Set this only to override, e.g. an external disk. Never a path inside the repo.
# BACKUP_ARCHIVE_DIR=/mnt/backup/homelab

BACKUP_CRON_EXPRESSION=0 3 * * *
BACKUP_RETENTION_DAYS=3

# Paths matching this Go regexp are left out of the archive. Default excludes
# Jellyfin's artwork cache, which Jellyfin re-downloads on a library scan --
# see README "What is deliberately not in the archive". Set to an empty
# string to archive everything.
# BACKUP_EXCLUDE_REGEXP=jellyfin-config/metadata/
