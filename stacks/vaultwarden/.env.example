# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8081
# Set true only long enough to create your account, then set false.
SIGNUPS_ALLOWED=false
# Leave empty to keep /admin disabled. Generate with: openssl rand -base64 48
ADMIN_TOKEN=
# External URL once Caddy is in front. Required for attachments and WebAuthn.
# DOMAIN=https://vault.example.com   # must include the scheme
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
