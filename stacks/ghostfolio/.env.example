# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=3333
POSTGRES_DB=ghostfolio
POSTGRES_USER=ghostfolio
# Required. openssl rand -base64 32 for each.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Required. Generate each with: openssl rand -base64 32
# Changing ACCESS_TOKEN_SALT locks every account out permanently.
ACCESS_TOKEN_SALT=
JWT_SECRET_KEY=
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
