# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=2586
# HOMELAB_HOST=my-server.local

# --- Publisher credentials ------------------------------------------------
# NOT read by this stack's container. Read by scripts/notify.py (every
# OnFailure= alert, the SMART scripts and the digest), and by the life-queue
# n8n container through env_file. This file is the one copy on disk.
# Not the repo-root .env: that file is non-secret identifiers only, and
# env_file hands every key in it to every stack that reads it.
NTFY_URL=http://127.0.0.1:2586
NTFY_TOPIC=homelab-alerts
# docker exec ntfy ntfy token add homelab -- see README
NTFY_TOKEN=
