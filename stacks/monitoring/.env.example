# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
# Loopback ports on homelab, for ssh -L.
VM_PORT=8428
GRAFANA_PORT=3007
# Grafana's local break-glass admin: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# The existing `homelab` ntfy user's token (write-only to homelab-alerts).
# On homelab it is already saved for other stacks; look there, do not make a new one.
NTFY_TOKEN=
# Must be set here: Compose interpolates labels from this stack's .env only.
PUBLIC_DOMAIN=
# Authentik provider `grafana` (README). Leave disabled on the laptop.
GRAFANA_OIDC_ENABLED=false
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=
