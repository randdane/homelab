# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=9000
PG_DB=authentik
PG_USER=authentik
# Required. Generate each with: openssl rand -base64 48
PG_PASS=
AUTHENTIK_SECRET_KEY=
# AUTHENTIK_TAG is NOT set here. The pin lives in compose.yaml, which is
# committed -- setting it here would shadow it from a gitignored file, and
# `git grep` would then report a version nothing runs. Override for a one-off
# test with `AUTHENTIK_TAG=x docker compose up -d`, never in .env.
# Required, and it must be the bare domain -- e.g. example.com, no scheme,
# no subdomain. The homepage.href label composes `<name>.${PUBLIC_DOMAIN}`
# from it. Compose interpolates labels from THIS file and never from the
# repo-wide .env, so the same value is written in each stack that needs it;
# `env_file` hands values to a container and does not feed `${VAR}`.
# Left blank on purpose -- see docs/lessons-learned.md 3.
PUBLIC_DOMAIN=
# Outpost token for the LDAP outpost, and the password Jellyfin binds with.
# Both are generated by the provisioning step, not chosen by hand -- see the
# README. They are written into .env directly and never printed.
# AUTHENTIK_LDAP_TOKEN=<generated>
# JELLYFIN_LDAP_BIND_PASSWORD=<generated>

# This host's LAN address, e.g. my-server.local. Published ports bind to it.
HOMELAB_HOST=
