# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8000
PUID=1000
PGID=1000
# Required. Generate with: openssl rand -base64 32
PAPERLESS_DB_PASSWORD=
# Required. Django session signing key. Generate with: openssl rand -base64 48
PAPERLESS_SECRET_KEY=
# Required: the vhost is paperless.<PUBLIC_DOMAIN>. Canonical copy is the
# repo-root .env.
PUBLIC_DOMAIN=
# Defaults to the vhost. Laptop testing only: PAPERLESS_URL=http://localhost:8000
PAPERLESS_OCR_LANGUAGE=eng
# SSO via Authentik (README). Client ID and secret come from the Authentik
# provider `paperless`; leave PAPERLESS_APPS blank where there is no client.
# PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_APPS=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Scan-to-SMB (README, "The scanner"). The scanner's Fixed IP on dream, and
# the host address to publish 445 on (homelab's LAN address; leave unset on
# the laptop, which binds 127.0.0.1). The raven password is not here: it is
# ~/.local/share/_r_/paperless-samba/raven_password on the host.
SCANNER_IP=
SAMBA_BIND_IP=
