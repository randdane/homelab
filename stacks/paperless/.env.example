# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8000
PUID=1000
PGID=1000
# Required. Generate with: openssl rand -base64 32
PAPERLESS_DB_PASSWORD=
# Required. Django session signing key. Generate with: openssl rand -base64 48
PAPERLESS_SECRET_KEY=
PAPERLESS_URL=http://localhost:8000
PAPERLESS_OCR_LANGUAGE=eng
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
