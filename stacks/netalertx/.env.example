# Nothing secret goes here. The UniFi key and the ntfy token are entered in
# the NetAlertX UI (README), because anything passed through the environment
# is written to /data and logged.
PUBLIC_DOMAIN=
# PORT=20211
# Fixed MAC for the container, so a restart is not reported as a new device.
# Locally administered (02:...), invented once per deployment:
#   printf '02:%02x:%02x:%02x:%02x:%02x\n' $(od -An -N5 -tu1 /dev/urandom)
NETALERTX_MAC=
