# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=9925
PUID=1000
PGID=1000
# Required: the vhost is mealie.<PUBLIC_DOMAIN>. Canonical copy is the
# repo-root .env.
PUBLIC_DOMAIN=
# Set true only long enough to create your account, then set false.
ALLOW_SIGNUP=false
# Defaults to the vhost. Laptop testing only: BASE_URL=http://localhost:9925
# SSO via Authentik (README). Client ID and secret come from the Authentik
# provider `mealie`; leave OIDC_AUTH_ENABLED=false where there is no client.
OIDC_AUTH_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
