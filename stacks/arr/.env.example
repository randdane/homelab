# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PUID=1000
PGID=1000
RADARR_PORT=7878
SONARR_PORT=8989
LIDARR_PORT=8686
BAZARR_PORT=6767
JELLYSEERR_PORT=5055
# Published by gluetun on behalf of the VPN-routed services.
QBITTORRENT_PORT=8082
PROWLARR_PORT=9696
TORRENT_PORT=6881

# --- VPN. Required: gluetun does not start without a provider, and
# --- qbittorrent/prowlarr have no network without gluetun.
# One of: airvpn, custom, fastestvpn, ivpn, mullvad, nordvpn, protonvpn,
# surfshark, windscribe. Per-provider variables: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
# WireGuard (preferred):
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# OpenVPN (if your provider needs it instead):
OPENVPN_USER=
OPENVPN_PASSWORD=
# Optional, e.g. Netherlands
SERVER_COUNTRIES=
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
