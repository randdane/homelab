# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
# The dashboard's allowed Host headers are BUILT from these two in
# compose.yaml, not written out here. Homepage matches the Host header
# literally, so `localhost:3001` does not cover `127.0.0.1:3001` or the LAN
# address, and a name missing from the list returns a host-validation 400
# that reads as a broken proxy rather than a missing setting.
#
# Both are `${VAR:?}` in compose.yaml: unset, the stack refuses to render.
# That is deliberate. This file previously shipped the whole list with
# `<SERVER_IP>` and `<PUBLIC_DOMAIN>` sitting inside it, which is a value a
# copy can accept without complaint -- the container starts and only the
# names you actually use fail.
#
# Compose interpolates these from THIS file, never the repo-wide .env:
# `env_file` hands values to a container and does not feed ${VAR}. That is
# also why the real domain stays out of git -- see scripts/test_identity_leak.py.

# This host's own LAN address, e.g. my-server.local -- the same HOMELAB_HOST
# every other stack's .env sets, and named the same on purpose. The Caddy
# vhost is the daily route; this is the break-glass path for when Caddy is
# the thing that is broken, which is exactly when you cannot afford the
# escape hatch to 400.
HOMELAB_HOST=

# The domain the vhost lives under, e.g. example.com -- homepage.<this>.
PUBLIC_DOMAIN=
