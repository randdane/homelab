# Copy to .env and fill in. .env is gitignored; this file is not.
# netalertr-deploy.sh fills most of this itself on first install.

# Base of the controller's Network API, through /proxy/network.
# e.g. https://<dream>/proxy/network
UNIFI_URL=
# A view-only key. Sent over ssh stdin by the deploy script.
UNIFI_API_KEY=

# The deploy script sets http://ntfy:80
NTFY_URL=
# The deploy script sets homelab-alerts
NTFY_TOPIC=
# Write-only token for NTFY_TOPIC. The deploy script creates it.
NTFY_TOKEN=

# Bearer token for the API. Generate with: openssl rand -hex 32
API_TOKEN=

# Read by netalertr_compare.py only: the four network names, comma-separated.
NETALERTR_EXPECTED_NETWORKS=

# Set by the deploy script.
NETALERTR_TAG=
