# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8095
OWNCLOUD_DOMAIN=localhost:8095
OWNCLOUD_TRUSTED_DOMAINS=localhost
# Required. Generate each with: openssl rand -base64 32
OWNCLOUD_DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
OWNCLOUD_ADMIN_USERNAME=admin
# Required. The web login you will actually type. openssl rand -base64 24
OWNCLOUD_ADMIN_PASSWORD=
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
