# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=3005
POSTGRES_DB=invidious
POSTGRES_USER=invidious
# Required. openssl rand -base64 32
POSTGRES_PASSWORD=
# Required. Signs cookies and CSRF tokens. openssl rand -hex 20
INVIDIOUS_HMAC_KEY=
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
