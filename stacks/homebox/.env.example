# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=7745
# Required: the vhost is homebox.<PUBLIC_DOMAIN>.
PUBLIC_DOMAIN=
# Required, >= 32 bytes: openssl rand -base64 48
HBOX_API_KEY_PEPPER=
# Set true only long enough to create your account, then set false.
ALLOW_REGISTRATION=false
# SSO via Authentik (README). From the Authentik provider `homebox`.
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
