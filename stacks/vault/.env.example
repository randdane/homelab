# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
# 8201, not 8200 -- Duplicati has 8200.
PORT=8201
# Required. Dev-mode root token; dev mode keeps everything in memory, see
# README. openssl rand -base64 32
VAULT_DEV_ROOT_TOKEN_ID=
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
