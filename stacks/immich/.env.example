# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=2283
# Required. Generate with: openssl rand -base64 32
DB_PASSWORD=
DB_USERNAME=immich
DB_DATABASE_NAME=immich
# IMMICH_VERSION is NOT set here -- the pin lives in compose.yaml, which is
# committed. It must match the database image's vector extension, which is
# exactly the kind of coupling that must not be recorded in a gitignored file.
# Required: the vhost is immich.<PUBLIC_DOMAIN>. Canonical copy is the
# repo-root .env.
PUBLIC_DOMAIN=
