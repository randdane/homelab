# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8096
# Required, and it must be the bare domain -- e.g. example.com, no scheme,
# no subdomain. The homepage.href label composes `<name>.${PUBLIC_DOMAIN}`
# from it. Compose interpolates labels from THIS file and never from the
# repo-wide .env, so the same value is written in each stack that needs it;
# `env_file` hands values to a container and does not feed `${VAR}`.
# Left blank on purpose -- see docs/lessons-learned.md 3.
PUBLIC_DOMAIN=
# Media library root. Bind-mounted read-only at /media.
# Default /srv/media matches the server; override on a host that keeps its
# library elsewhere.
# JELLYFIN_MEDIA_DIR=/srv/media
# Owner of the Jellyfin data. Must match the uid/gid that owns the config
# volume; changing it on an existing install makes the library unreadable.
PUID=1000
PGID=1000
# Hardware transcoding. The render node that is the *Intel* iGPU -- on a
# multi-GPU host this may not be renderD128. Check with:
#   readlink -f /sys/class/drm/renderD128/device/driver
# INTEL_RENDER_NODE=/dev/dri/renderD128
# gid of the host's `render` group:  getent group render | cut -d: -f3
RENDER_GID=990
