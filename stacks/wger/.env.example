# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8093
# Required. Django signing keys. openssl rand -base64 48
SECRET_KEY=
SIGNING_KEY=
# Required. openssl rand -base64 32
DJANGO_DB_PASSWORD=
WGER_INSTANCE=http://localhost:8093
ALLOW_REGISTRATION=False
ALLOW_GUEST_USERS=False
# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local
