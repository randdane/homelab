# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=8094
PROXY_PORT=2377
# Required, the bare domain: the vhost is beszel.<PUBLIC_DOMAIN>.
PUBLIC_DOMAIN=
# Required for the agent. The hub's public key, from its "Add system" dialog
# after the first run (README). The hub starts without it.
BESZEL_KEY=
