# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env && chmod 600 .env
#
# Every credential below is mandatory -- compose.yaml declares them with
# `:?`, so a missing one stops the stack at `up` rather than at the first
# failed request.
TZ=America/Chicago

# Server: 80/443. Laptop: use high ports -- 443 collides with tailscaled here.
HTTP_PORT=80
HTTPS_PORT=443

# The headscale control-plane vhost, and nothing else. It is a variable
# because it is the one site address that differs between the server and a
# laptop: an http:// or localhost value disables automatic TLS, which is what
# makes this stack runnable with no domain. Every other vhost is built in
# config/Caddyfile from PUBLIC_DOMAIN and DUCKDNS_HOST, which live in the
# REPO-ROOT .env rather than this file -- see ../../.env.example.
SITE_ADDRESS=http://localhost

# Set this to the server hostname/IP when this stack moves off the laptop.
# HOMELAB_HOST=my-server.local

# CrowdSec bouncer API key. Issue with:
#   docker exec crowdsec cscli bouncers add caddy-bouncer
# Shown exactly once. Caddy refuses to start without it.
CROWDSEC_API_KEY=

# Porkbun API credentials, for the DNS-01 challenge that issues the
# *.${PUBLIC_DOMAIN} wildcard. Two steps, and the second is easy to miss:
#   1. create a key at porkbun.com/account/api
#   2. switch API ACCESS on for the domain itself, under Domain Management --
#      a valid key without this gets "domain not opted in"
# DNS-01 is not a preference here. The names under the wildcard resolve to a
# private address, so Let's Encrypt cannot reach them for HTTP-01 at all.
PORKBUN_API_KEY=
PORKBUN_API_SECRET_KEY=
