# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=9926
# Required: the vhost is mealier.<PUBLIC_DOMAIN>. Canonical copy is the
# repo-root .env.
PUBLIC_DOMAIN=
# Required: the image, ghcr.io/<github owner>/mealier, and its tag, a full
# commit sha that CI built and pushed.
MEALIER_IMAGE=
MEALIER_TAG=
# Break-glass local admin. Make the hash with:
#   docker run --rm -i $MEALIER_IMAGE:<tag> hash-password
# then set the hash and FILE=/run/secrets/admin_password_hash. Blank leaves
# local login disabled. Compose turns the value into that file.
MEALIER_ADMIN_PASSWORD_HASH=
MEALIER_ADMIN_PASSWORD_FILE=
# SSO via Authentik (README). Leave the URL blank where there is no client;
# with a client, OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret.
OIDC_CONFIGURATION_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=
