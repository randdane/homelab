# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=3006
# Required. Generate each with: openssl rand -base64 36
NEXTAUTH_SECRET=
MEILI_MASTER_KEY=
# Required. The vhost, https://karakeep.<PUBLIC_DOMAIN>
NEXTAUTH_URL=
# Set true after creating your account.
DISABLE_SIGNUPS=false
# KARAKEEP_VERSION is NOT set here -- the pin lives in compose.yaml, which is
# committed. Upstream ships a rolling 'release' tag; this repo pins a real
# version instead. See the note in compose.yaml.
# Required by the homepage label. Canonical copy is the repo-root .env.
PUBLIC_DOMAIN=

# Optional: enables AI summaries/tags. Leave blank to keep inference off.
OPENAI_API_KEY=

# Optional: SSO through Authentik, provider `karakeep`. Blank = off.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
