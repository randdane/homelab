# Copy to .env and fill in. .env is gitignored; this file is not.
TZ=America/Chicago
PORT=3002
SSH_PORT=3003
PUID=1000
PGID=1000
# Required. Generate with: openssl rand -hex 32
# Hex, not base64: same 256 bits, but the alphabet is 0-9a-f, so the value can
# never contain a '$' (which Compose would interpolate in this file) or '+' '/'
# (which need escaping inside a connection string).
FORGEJO_DB_PASSWORD=
# Clone URLs and the SSO redirect are built from this. MUST be set on the
# server, or the web UI hands out clone commands pointing at localhost.
# On homelab it is the gated vhost; the published port still works for
# existing remotes. SSH clone URLs use HOMELAB_HOST, not this.
# FORGEJO_ROOT_URL=https://forgejo.<PUBLIC_DOMAIN>/
# HOMELAB_HOST=my-server.local
# Required by the homepage label. Canonical copy is the repo-root .env.
PUBLIC_DOMAIN=
