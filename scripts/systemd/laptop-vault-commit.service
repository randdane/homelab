# Weekly Obsidian vault commit + push to Forgejo. A user unit on the laptop, where
# the vault lives; installed by hand like laptop-lan-route.service:
#
#   cp scripts/systemd/laptop-vault-commit.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now laptop-vault-commit.timer
#
# No OnFailure=: the script reports its own failures, with a /fail ping to the
# healthchecks.io check `vault-commit` and an ntfy message read from the
# laptop's stacks/ntfy/.env. The check still covers the week where the script
# never ran at all, because the success ping goes missing.
[Unit]
Description=Weekly Obsidian vault commit and push to Forgejo

[Service]
Type=oneshot
# The script retries the push for about ten minutes, because the timer can
# fire in the same second the laptop resumes. Leave room for slow attempts.
TimeoutStartSec=1800
ExecStart=%h/Projects/_personal/homelab/scripts/vault-commit.sh
